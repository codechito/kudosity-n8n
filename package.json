{
  "name": "n8n-nodes-kudosity",
  "version": "0.1.0",
  "description": "n8n community node for Kudosity \u2014 send SMS, MMS, WhatsApp, and RCS messages via the TransmitMessage API",
  "keywords": [
    "n8n-community-node-package",
    "kudosity",
    "sms",
    "mms",
    "whatsapp",
    "rcs",
    "transmitmessage"
  ],
  "license": "MIT",
  "homepage": "https://developers.kudosity.com",
  "author": {
    "name": "Kudosity"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codechito/kudosity-n8n.git"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-icons.js",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/KudosityApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Kudosity/Kudosity.node.js",
      "dist/nodes/Kudosity/KudosityTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^18.16.16",
    "n8n-workflow": "*",
    "typescript": "^5.1.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "types": "dist/index.d.ts"
}
